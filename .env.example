# sast-ai 环境变量样例（复制为 .env 后填写）
#
# 本项目配置以环境变量为主；config.yaml 只保存 LLM provider 默认参数，
# 且已被 .gitignore 排除（含密钥），请勿提交真实配置。

# ---------- 服务 ----------
SAST_AI_API_HOST=127.0.0.1
SAST_AI_API_PORT=8000
SAST_AI_CORS_ORIGINS=http://127.0.0.1:5173
SAST_AI_DB_PATH=data/app.db

# 鉴权（默认关闭；对外暴露时务必开启）
SAST_AI_AUTH_ENABLED=0
# 逗号分隔的 key:role，role ∈ admin/operator/viewer
SAST_AI_API_KEYS=

# ---------- LLM ----------
# 默认走本地 Ollama；用云厂商时改 BASE_URL 并在 config.yaml 配置对应 provider
SAST_AI_BASE_URL=http://127.0.0.1:11434
SAST_AI_MODEL=qwen3:8b
# 输出格式：json / schema（grammar 约束解码）/ off
SAST_AI_LLM_FORMAT=json

ANTHROPIC_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
MINIMAX_API_KEY=

# ---------- 外部工具 ----------
# 第三方二进制目录（scripts/fetch_tools.py --dest 的目标）
SAST_AI_TOOLS_DIR=
SAST_AI_YSOSERIAL_JAR=

# ---------- 扫描行为 ----------
# LLM 反馈闭环：小靶场建议关闭（四轮实测零增益）
SAST_AI_CLOSED_LOOP=0
# Benchmark URL 布局先验：盲测时置 0
SAST_AI_BENCHMARK_PRIOR=1
SAST_AI_TASK_MAX_WORKERS=2

# ---------- 靶场/探针 ----------
# IAST 探针回传地址（默认同后端）
SAST_AI_AGENT_URL=http://127.0.0.1:8000/api/agent/events
# 探针 agent token（由靶场启动脚本注入，勿写入代码）
SAST_AI_AGENT_TOKEN=
# 探针 session token：必须与后端 iast_sessions 注册值一致。仓库不再提供任何默认值，
# 未配置时 event ingest 会拒收（表现为 HTTP 200 但 accepted=0）。
SAST_AI_PROBE_TOKEN=

# ---------- 本机路径（按部署环境填写，仓库不含任何绝对路径）----------
# java 可执行文件；留空时取 PATH 上的 java
SAST_AI_JAVA=
# 探针 jar；默认 <repo>/probe-java/target/sec-probe.jar
SAST_AI_PROBE_JAR=
# 靶场 jar（不随仓库分发）
SAST_AI_JAVA_QUOTE_JAR=
# ysoserial gadget 构造用的 JDK8 根目录
SAST_AI_JDK8_HOME=
# CodeQL 建库时追加的 JDK 扫描根目录 / gadget 候选（后者用 os.pathsep 分隔）
SAST_AI_JDK_ROOT=
SAST_AI_JDK_CANDIDATES=
# 看门狗可选项
SAST_AI_VENV_PY=
SAST_AI_FRONTEND_DIR=
SAST_AI_NODE_VERSIONS_DIR=
SAST_AI_JAVA_QUOTE_LOG=

# ---------- 靶场启动脚本（靶场是外部项目，不随仓库分发）----------
# 不设时启动脚本回退到「与本仓库同级、同名目录」的约定。
SAST_AI_SECCODE_DIR=
SAST_AI_OWASP_DIR=
SAST_AI_OWASP_FULL_DIR=
SAST_AI_TARGET_MALL_DIR=
# 探针 jar 路径；不设时取仓库内构建产物 probe-java/target/sec-probe.jar
SAST_AI_PROBE_JAR=
# OWASP 脚本起 HSQLDB 服务用的 JDK；不设时用脚本自身的 JAVA_HOME
SAST_AI_HSQLDB_JAVA=

# ---------- 网络与认证形态（D1 执行层）----------
# 后端 / 靶场默认都跑在 127.0.0.1；跨机部署时把 SAST_AI_API_HOST 与
# SAST_AI_AGENT_URL 一起改成目标机可达地址，并开启 SAST_AI_AUTH_ENABLED。
# 登录墙识别路径（逗号分隔，3xx 且 Location 落在该路径才触发重登）
SAST_AI_LOGIN_PATHS=/login
# 主动注销端点：命中时 3xx→/login 属业务预期，不触发重登
SAST_AI_LOGOUT_PATHS=/logout,/signout,/j_spring_security_logout,/api/logout
# per-request 认证守卫（0 关闭）
SAST_AI_D1_AUTH_GUARD=1

# ---------- 测试 ----------
# 依赖外部靶场源码的集成测试：指向本地靶场根目录（如 /path/to/SDL），
# 未设置时这些测试显式 skip，不会假装通过。
SAST_AI_SDL_ROOT=
